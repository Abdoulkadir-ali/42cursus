A 0.0 0,0,0
C 0,0,90 0,0,-1 55

# Single bright point light slightly off-axis
L -5,8,15 150 255,240,200

# ── Black hole ────────────────────────────────────────────────────────────────
# Black hole: mass=1e8 → Rs = 2*1e-8*1e8 = 2.0 units, influence = 2*20 = 40 units
bhole 0,0,0  100000000

# ── Background: dense grid of bright emissive spheres at z=-18 ────────────────
sp  -9, 7,-18  1.5  255, 80, 80
sp   0, 7,-18  1.5   80,255, 80
sp   9, 7,-18  1.5   80, 80,255
sp  -9, 2,-18  1.5  255,255, 60
sp   0, 2,-18  1.5  255, 80,255
sp   9, 2,-18  1.5   60,255,255
sp  -9,-3,-18  1.5  255,160, 40
sp   0,-3,-18  1.5  160, 40,255
sp   9,-3,-18  1.5   40,200,255
sp  -4, 5,-18  1.5  200,255,120
sp   4, 5,-18  1.5  120,200,255
sp  -4, 0,-18  1.5  255,200, 80
sp   4, 0,-18  1.5   80,255,200

# Dim background wall for rays that miss all spheres
pl 0,0,-22 0,0,1 25,25,45
