
# Ambient Light
A 0.4 255,255,255

# Camera
C 0,10,30 0,-0.2,-1 70

# Light
L 10,20,10 0.8 255,255,255

# Floor (Checkered via separate mechanism or grey)
pl 0,0,0 0,1,0 200,200,200

# Glass Sphere (Magenta)
sp -4,4,0 6.0 255,0,255

# Water Sphere (Blue)
sp 4,4,0 6.0 0,0,255

# Background Sphere (Red) to see refraction
sp 0,4,-10 4.0 255,50,50
