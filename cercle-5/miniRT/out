# define DBVT_MAX_NODES 4096
# define DBVT_MAX_LEAVES 2048

/* --- Types & Enums --- */

typedef enum e_phys_type
{
	TYPE_PHYS_SPHERE,
	TYPE_PHYS_BOX,
	TYPE_PHYS_CAPSULE,
	TYPE_PHYS_CYLINDER,
	TYPE_PHYS_RECT,
	TYPE_PHYS_TRI,
	TYPE_PHYS_PYRAMID,
	TYPE_PHYS_MESH
}	t_phys_type;

/* Fonction de support pour l'algorithme GJK */
typedef t_vec3	(*t_support_fn)(const void *shape, t_vec3 dir);

/* --- LE COMPOSANT : Corps Physique --- */

typedef struct s_physics_body
{
	/* Lien vers l'objet de la scène (Découplage) */
	t_transform		*transform;  /* Pointeur vers le transform réel dans la scène */
	void			*shape_data; /* Donnée brute (ex: t_sphere*) pour le GJK */
	t_phys_type		type;
	void			*user_data;  /* Pour retrouver l'objet parent si besoin */

	/* Propriétés Dynamiques */
	t_vec3			velocity;
	t_vec3			angular_velocity;
	t_vec3			torque;
	double			mass;
	double			inv_mass;
	t_mat3			inv_inertia;
	
	/* Matériau Physique */
	double			elasticity;
	double			friction;
	bool			is_static;
	bool			is_active;

	/* Géométrie de collision (Compound shapes) */
	struct s_sub_shape
	{
		void		*shape;
		t_aabb		local_aabb;
		t_vec3		offset;
		t_mat4		transform;
		double		radius;
		t_phys_type	type;
	}				sub_shapes[MAX_SUB_SHAPES];
	size_t			sub_count;
	t_aabb			global_aabb;
}	t_physics_body;

/* --- LE SYSTÈME : Contexte du Moteur --- */

typedef struct s_contact
{
	t_physics_body	*a;
	t_physics_body	*b;
	t_vec3			normal;
	double			penetration;
	t_vec3			contact_point;
}	t_contact;

/* Threading */
typedef struct s_phys_job
{
	t_scene			*scene;
	t_contact		*out_contacts;
	int				max_contacts;
	int				found_count;
	int				thread_id;
}	t_phys_job;

typedef struct s_physics
{
	/* Pool de corps : Alloué de manière contiguë pour le cache L1/L2 */
	t_physics_body	bodies[PHYS_MAX_BODIES];
	int				body_count;

	/* Configuration de la simulation */
	t_vec3			gravity;
	double			fixed_dt;
	int				solver_iterations;

	/* Thread Pool */
	pthread_t		threads[PHYS_NUM_THREADS];
	t_phys_job		jobs[PHYS_NUM_THREADS];
	sem_t			sem_start[PHYS_NUM_THREADS];
	sem_t			sem_done[PHYS_NUM_THREADS];
	int				shutdown;

	/* Broadphase : Dynamic AABB Tree */
	struct s_dbvt
	{
		struct s_dbvt_node { t_aabb aabb; int left, right, leaf; } nodes[DBVT_MAX_NODES];
		struct s_dbvt_leaf { t_aabb fat; t_physics_body *body; } leaves[DBVT_MAX_LEAVES];
		int node_count;
		int leaf_count;
		int root;
	}				tree;

	/* Environnement Statique (BVH) */
	t_static_bvh	*static_env;
}	t_physics;

/* ------------------------------------------------------------------------- */
/* API DU MOTEUR                                                             */
/* ------------------------------------------------------------------------- */

/* Initialisation & Cycle de vie */
t_physics	*phys_create(void);
void		phys_destroy(t_physics *phys);

/**
 * BAKING : Parcourt la scène et génère les t_physics_body correspondants.
 * C'est ici que le lien transform -> transform est établi.
 */
void		phys_bake_scene(t_physics *phys, t_scene *scene);

/**
 * SIMULATION : La fonction principale appelée par la GUI à chaque frame.
 */
void		phys_step(t_physics *phys, t_scene *scene, double dt);

/* Pipeline Interne */
void		phys_integrate(t_physics *phys, double dt);
int			phys_detect_collisions(t_physics *phys, t_contact *out, int max);
void		phys_solve(t_physics *phys, t_contact *contacts, int count);

/* Support GJK */
t_vec3		phys_support(t_physics_body *body, t_vec3 dir);

/* Interactions */
void		phys_apply_impulse(t_physics_body *body, t_vec3 impulse, t_vec3 point);
void		phys_shoot_force(t_physics *phys, t_ray ray, double power);

